{
	"name": "arc",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/shyim/devcontainers-features/bun:0": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {}
	},
	"mounts": [
		// Claude Code's login, session history, plugins and auto-memory. Without
		// this they live in the container's writable layer and every rebuild
		// silently costs you all four.
		"type=volume,source=${localWorkspaceFolderBasename}-claude-home,target=/home/vscode/.claude"
	],
	"postCreateCommand": "bash .devcontainer/startup.sh",
	"forwardPorts": [
		80,
		8000,
		5432,
		3000
	],
	"portsAttributes": {
		"80": {
			"label": "arc (Caddy)",
			"onAutoForward": "silent"
		},
		"8000": {
			"label": "API Service",
			"onAutoForward": "silent"
		},
		"5432": {
			"label": "PostgreSQL Database",
			"onAutoForward": "silent"
		},
		"3000": {
			"label": "Frontend Service",
			"onAutoForward": "silent"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"charliermarsh.ruff",
				"meta.pyrefly",
				"biomejs.biome",
				"bradlc.vscode-tailwindcss",
				"streetsidesoftware.code-spell-checker",
				"fill-labs.dependi",
				"tamasfe.even-better-toml",
				"github.vscode-github-actions",
				"DavidAnson.vscode-markdownlint",
				"eamodio.gitlens",
				"redhat.vscode-yaml",
				"GitHub.copilot-chat",
				"GitHub.codespaces",
				"Anthropic.claude-code"
			]
		}
	}
}
