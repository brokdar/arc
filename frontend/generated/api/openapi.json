{
  "components": {
    "schemas": {
      "AnchorSource": {
        "description": "Who appended the version. Distinct from :class:`Provenance`.\n\nProvenance is about the *value*; source is about the *writer*, and the\nagent may never disguise itself as the athlete (build plan \u00a70.7).",
        "enum": ["athlete", "agent"],
        "title": "AnchorSource",
        "type": "string"
      },
      "AnchorType": {
        "description": "Anchor quantities the application knows about.\n\n``CP`` and ``W_PRIME`` are reserved by the build plan: the critical-power\nmodel is out of MVP scope, but the enum member exists so adding it later\nis not a migration of stored values. Nothing produces or consumes them\nyet, and :func:`app.domain.zones.zones_for` rejects them.",
        "enum": ["ftp", "lthr", "max_hr", "cp", "w_prime"],
        "title": "AnchorType",
        "type": "string"
      },
      "AnchorUnit": {
        "description": "Units an anchor value can be expressed in.",
        "enum": ["W", "bpm", "J"],
        "title": "AnchorUnit",
        "type": "string"
      },
      "AnchorVersionCreate": {
        "additionalProperties": false,
        "description": "Payload for appending a version to an anchor's history.",
        "properties": {
          "anchor_type": {
            "$ref": "#/components/schemas/AnchorType"
          },
          "ci_high": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 100000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci High"
          },
          "ci_low": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 100000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci Low"
          },
          "effective_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Date"
          },
          "protocol": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[^\\x00]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnchorUnit"
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Value",
            "type": "number"
          }
        },
        "required": ["anchor_type", "value", "provenance"],
        "title": "AnchorVersionCreate",
        "type": "object"
      },
      "AnchorVersionRead": {
        "description": "One anchor version as returned by the API.",
        "properties": {
          "anchor_type": {
            "$ref": "#/components/schemas/AnchorType"
          },
          "ci_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci High"
          },
          "ci_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ci Low"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "effective_date": {
            "format": "date",
            "title": "Effective Date",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "protocol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "source": {
            "$ref": "#/components/schemas/AnchorSource"
          },
          "staleness_state": {
            "$ref": "#/components/schemas/StalenessState"
          },
          "unit": {
            "$ref": "#/components/schemas/AnchorUnit"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "id",
          "anchor_type",
          "value",
          "unit",
          "provenance",
          "protocol",
          "effective_date",
          "ci_low",
          "ci_high",
          "source",
          "staleness_state",
          "created_at"
        ],
        "title": "AnchorVersionRead",
        "type": "object"
      },
      "AthleteRead": {
        "description": "The athlete profile as returned by the API.\n\nEvery field is nullable: the profile is bootstrapped empty on first access\nand filled in from the UI.",
        "properties": {
          "capabilities": {
            "additionalProperties": true,
            "title": "Capabilities",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "date_of_birth": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Of Birth"
          },
          "height_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Cm"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "name",
          "date_of_birth",
          "sex",
          "height_cm",
          "capabilities",
          "created_at",
          "updated_at"
        ],
        "title": "AthleteRead",
        "type": "object"
      },
      "AthleteUpdate": {
        "additionalProperties": false,
        "description": "Payload for partially updating the profile.\n\nOmitted fields are left unchanged; an explicit ``null`` clears a field\n(for ``sex`` and ``capabilities``, \"clear\" means back to ``unspecified``\nand ``{}`` \u2014 those two have an empty value rather than an absent one).",
        "properties": {
          "capabilities": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capabilities"
          },
          "date_of_birth": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Of Birth"
          },
          "height_cm": {
            "anyOf": [
              {
                "maximum": 250.0,
                "minimum": 100.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Cm"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[^\\x00]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "sex": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Sex"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "AthleteUpdate",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "Error response body, as produced by the AppError handler.\n\nReference it in endpoint ``responses={...}`` declarations so error\nstatuses are part of the OpenAPI contract (and the generated frontend\ntypes).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": ["detail"],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Health probe response.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Credentials for the single-user login.",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["password"],
        "title": "LoginRequest",
        "type": "object"
      },
      "Page_AnchorVersionRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnchorVersionRead"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": ["items", "total", "offset", "limit"],
        "title": "Page[AnchorVersionRead]",
        "type": "object"
      },
      "Provenance": {
        "description": "Where an anchor value came from \u2014 ordered weakest to strongest.\n\nThe order matters: it is what later work packages compare when deciding\nwhether a new value should displace the one in use.",
        "enum": ["assumed", "estimated", "athlete_reported", "tested"],
        "title": "Provenance",
        "type": "string"
      },
      "SessionStatus": {
        "description": "Whether the caller currently holds an authenticated session.",
        "properties": {
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          }
        },
        "required": ["authenticated"],
        "title": "SessionStatus",
        "type": "object"
      },
      "Sex": {
        "description": "Biological sex, as it affects physiological reference values.\n\n``UNSPECIFIED`` is a real member rather than ``None`` so the column is\nnever null and reads state \"not answered\" instead of \"unknown why\".",
        "enum": ["female", "male", "unspecified"],
        "title": "Sex",
        "type": "string"
      },
      "StalenessState": {
        "description": "How much an anchor version is still to be trusted.\n\nThe staleness *model* is deferred past the MVP, but the field is not:\nevery version stores one, hardcoded to ``FRESH`` today (see\n:data:`MVP_STALENESS_STATE`). ``AGING`` and ``STALE`` are reserved so that\nturning the model on later is code, not a data migration.",
        "enum": ["fresh", "aging", "stale"],
        "title": "StalenessState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationErrorDetail": {
        "description": "422 response body \u2014 the one status with two shapes.\n\nA service raising :class:`ValidationError` produces a sentence; FastAPI's\nown request validation produces its list of per-field errors. Both are\n422s on the same endpoint, so the declared contract has to admit both, or\na schema-conformance fuzzer is right to call one of them a lie.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "required": ["detail"],
        "title": "ValidationErrorDetail",
        "type": "object"
      },
      "ZoneModel": {
        "description": "The zone schemes the MVP supports.\n\nOne per channel: power zones off FTP, heart-rate zones off LTHR. Adding a\nmodel is adding a member plus a row in :data:`_ZONE_SCHEMES`.",
        "enum": ["coggan_7", "lthr_5"],
        "title": "ZoneModel",
        "type": "string"
      },
      "ZoneRead": {
        "description": "One half-open zone band ``[lower, upper)``.",
        "properties": {
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "lower": {
            "title": "Lower",
            "type": "number"
          },
          "lower_pct": {
            "title": "Lower Pct",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/AnchorUnit"
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper"
          },
          "upper_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper Pct"
          }
        },
        "required": [
          "index",
          "name",
          "lower_pct",
          "upper_pct",
          "lower",
          "upper",
          "unit"
        ],
        "title": "ZoneRead",
        "type": "object"
      },
      "ZonesRead": {
        "description": "The computed zones, with the two inputs they came from.\n\nThe anchor version is returned in full because it is the provenance of\nevery number in ``zones``; a client that caches the zones caches the\nversion id with them.",
        "properties": {
          "anchor_version": {
            "$ref": "#/components/schemas/AnchorVersionRead"
          },
          "model": {
            "$ref": "#/components/schemas/ZoneModel"
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/ZoneRead"
            },
            "title": "Zones",
            "type": "array"
          }
        },
        "required": ["anchor_version", "model", "zones"],
        "title": "ZonesRead",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "in": "cookie",
        "name": "arc_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "arc",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/anchors": {
      "get": {
        "description": "List anchor versions, newest first, optionally for one anchor type.",
        "operationId": "anchors-list_anchor_versions",
        "parameters": [
          {
            "description": "Restrict to one anchor type; omit for all of them.",
            "in": "query",
            "name": "anchor_type",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/AnchorType",
              "description": "Restrict to one anchor type; omit for all of them."
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 2147483647,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_AnchorVersionRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "No valid session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "List Anchor Versions",
        "tags": ["anchors"]
      },
      "post": {
        "description": "Append a new version to an anchor's history.",
        "operationId": "anchors-append_anchor_version",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnchorVersionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnchorVersionRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Malformed body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "No valid session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDetail"
                }
              }
            },
            "description": "Version violates a schema or domain rule"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Append Anchor Version",
        "tags": ["anchors"]
      }
    },
    "/api/v1/anchors/current": {
      "get": {
        "description": "Get the version of one anchor currently in force.\n\n\"In force\" is a domain rule, not `ORDER BY created_at DESC`: a version\neffective from a future date does not count yet, and a back-dated\ncorrection does.",
        "operationId": "anchors-get_current_anchor_version",
        "parameters": [
          {
            "description": "Which anchor to resolve.",
            "in": "query",
            "name": "anchor_type",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AnchorType",
              "description": "Which anchor to resolve."
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnchorVersionRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "No valid session"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Anchor version not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Get Current Anchor Version",
        "tags": ["anchors"]
      }
    },
    "/api/v1/anchors/{anchor_version_id}": {
      "delete": {
        "description": "Refuse to delete an anchor version (405).\n\nRaises:\n    MethodNotAllowedError: Always. See :data:`APPEND_ONLY_DETAIL`.",
        "operationId": "anchors-delete_anchor_version",
        "parameters": [
          {
            "in": "path",
            "name": "anchor_version_id",
            "required": true,
            "schema": {
              "title": "Anchor Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "No valid session"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Anchor history is append-only"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Delete Anchor Version",
        "tags": ["anchors"]
      },
      "get": {
        "description": "Get one anchor version by id.",
        "operationId": "anchors-get_anchor_version",
        "parameters": [
          {
            "in": "path",
            "name": "anchor_version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Anchor Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnchorVersionRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "No valid session"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Anchor version not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Get Anchor Version",
        "tags": ["anchors"]
      },
      "patch": {
        "description": "Refuse to edit an anchor version (405).\n\nRaises:\n    MethodNotAllowedError: Always. See :data:`APPEND_ONLY_DETAIL`.",
        "operationId": "anchors-update_anchor_version",
        "parameters": [
          {
            "in": "path",
            "name": "anchor_version_id",
            "required": true,
            "schema": {
              "title": "Anchor Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "No valid session"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Anchor history is append-only"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
