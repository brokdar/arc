{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_npm.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyrefly-lsp@arc-local": true,
    "tsgo-lsp@arc-local": true,
    "commit-commands@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "arc-local": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  }
}
