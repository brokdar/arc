# ============================================================================
# arc — Environment Configuration
# ============================================================================
# `just init` copies this file to .env and fills in the REQUIRED block below
# with fresh secrets and a hash of the password you choose — prefer it over
# copying by hand.
# Nested keys use Pydantic double-underscore delimiters:
# POSTGRES__HOST maps to settings.postgres.host in backend/app/core/config.py.
# A backend test (test_env_example_completeness) keeps this file in sync with
# the settings model — add new settings here when you add them in code.

# ============================================================================
# REQUIRED — no safe defaults, set before running
# ============================================================================
POSTGRES__PASSWORD=change-me
# bcrypt hash of the single user's password — generate it with
# `just hash-password`. MUST be single-quoted: bcrypt hashes contain `$`,
# which .env parsers and your shell would otherwise expand.
AUTH__PASSWORD_HASH='change-me-to-a-bcrypt-hash'
# Signs the session cookie. Rotating it logs the user out.
# Generate with: openssl rand -hex 32
AUTH__SESSION__SECRET_KEY=change-me-to-a-random-64-char-hex-string
# Required by the `mcp` service only — it exits 1 without keys. `docker
# compose up` starts that service, so set this before booting the stack.
MCP__API_KEYS='coach:read+write:change-me-random-hex,readonly:read:change-me-random-hex'
# Encrypts third-party credentials at rest — today the Dropbox refresh token.
# A Fernet key: 32 random bytes, urlsafe-base64 encoded. Generate with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it does NOT log you out (that is AUTH__SESSION__SECRET_KEY): it makes
# every stored cloud credential unreadable, and the settings page says so rather
# than silently failing to refresh. The production boot guard refuses an empty
# value, because a connection stored under no key is one nobody can ever open.
SECRETS__ENCRYPTION_KEY=change-me-to-a-fernet-key

# ============================================================================
# Application
# ============================================================================
# APPLICATION_NAME=arc
# ENVIRONMENT=development
# ^ Only affects processes you run on the host (`just dev-api`, `just dev-mcp`,
# tests). docker-compose.yml pins ENVIRONMENT=production on the api and mcp
# services with an `environment:` entry, which overrides this file — so the
# containers always run the production config guard, which refuses to boot with
# an empty AUTH__PASSWORD_HASH or AUTH__SESSION__SECRET_KEY, or with the
# default POSTGRES__PASSWORD. Setting it here will not loosen that.
# API_PATH=/api/v1
# CORS_ORIGINS=["http://localhost:3000"]

# ============================================================================
# PostgreSQL
# ============================================================================
# `db` is the compose service name and only resolves inside the Docker network.
# Host-run processes need localhost instead — `just dev-api`, `just dev-mcp`,
# `just db-upgrade` and `just db-revision` pass POSTGRES__HOST=localhost, which
# overrides this line (a real env var always beats .env).
POSTGRES__HOST=db
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__DB=app

# ============================================================================
# Data (runtime file tree: inbox/, originals/, streams/, quarantine/)
# ============================================================================
# Relative paths resolve against the process working directory. Inside the
# containers this is /app/data, bind-mounted from ./data on the host.
DATA__ROOT=data

# ============================================================================
# Ingest (the watched folder — drop FIT/GPX/TCX files into data/inbox/)
# ============================================================================
# How often the scheduler sweeps the inbox, in seconds.
# INGEST__SCAN_INTERVAL_SECONDS=30
# How long a file must sit unchanged before it is read. A file still being
# copied is a truncated file; the scan also skips anything whose size changed
# since the previous sweep.
# INGEST__SETTLE_SECONDS=2.0
# Fraction of an activity's time range that may overlap an existing session
# before it is quarantined as a suspected duplicate for you to confirm.
# INGEST__OVERLAP_THRESHOLD=0.70

# ============================================================================
# Matching (WP-6 — linking recorded sessions to planned ones)
# ============================================================================
# YOUR local timezone. It decides when a planned session runs out of grace and
# is marked missed ("no link by the end of the following day"), which is a
# statement about your clock, not the server's. An IANA name is strongly
# preferred over a fixed offset — `UTC+02:00` is an hour wrong for half the
# year, and an hour is exactly what a day boundary turns on.
# MATCHING__TIMEZONE=UTC
# How often the missed-session sweep runs, in seconds. Hourly, because its job
# is to notice a day boundary passing in the zone above.
# MATCHING__MISSED_SCAN_INTERVAL_SECONDS=3600
# Most planned sessions one sweep will mark missed. A first run after a long
# absence catches up over a few passes instead of in one transaction.
# MATCHING__MISSED_SCAN_BATCH=200

# ============================================================================
# Scoring (WP-7 — axis scores, verdicts and the reasons behind them)
# ============================================================================
# How often the evening-prompt expiry sweep runs, in seconds. Each prompt
# stores its own 72-hour deadline, so this only decides how soon after that
# deadline an unanswered prompt is closed with the reason `not_provided`.
# SCORING__PROMPT_EXPIRY_INTERVAL_SECONDS=3600
# Most prompts one sweep will expire. A first run after a long absence catches
# up over a few passes instead of in one transaction.
# SCORING__PROMPT_EXPIRY_BATCH=200

# ============================================================================
# Wellness (Increment 1 — the daily prompt that asks once and expires)
# ============================================================================
# The hour, on the athlete's own clock (MATCHING__TIMEZONE), at which the day's
# wellness prompt is raised. One prompt per date, ever — the unique constraint
# on `wellness_prompts.local_date` is what makes that true.
# WELLNESS__PROMPT_HOUR_LOCAL=19
# How long the athlete has to answer before the day closes as `expired`, in
# hours. Stamped on each prompt when it is raised, so a change here never
# re-dates a prompt already standing. No follow-up prompt is ever raised.
# WELLNESS__PROMPT_EXPIRY_HOURS=36
# How often the raise-and-expire sweep runs, in seconds.
# WELLNESS__PROMPT_SCAN_INTERVAL_SECONDS=3600
# Most prompts one sweep will expire. A first run after a long absence catches
# up over a few passes instead of in one transaction.
# WELLNESS__PROMPT_SCAN_BATCH=200

# ============================================================================
# Proposals (WP-8 — plan changes the coaching agent suggests)
# ============================================================================
# How often the proposal expiry sweep runs, in seconds. Each proposal carries
# its own deadline; this only decides how soon after it a standing proposal is
# marked `lapsed`. Nothing is applied on expiry — the committed plan stands.
# PROPOSALS__EXPIRY_INTERVAL_SECONDS=3600
# Most proposals one sweep will lapse. A first run after a long absence
# catches up over a few passes instead of in one transaction.
# PROPOSALS__EXPIRY_BATCH=200
# Furthest ahead a proposal's deadline may be set, in days. A proposal dated
# past every sweep never drains from the pending set, and a suggestion nobody
# has to answer this season is not one.
# PROPOSALS__MAX_HORIZON_DAYS=90

# ============================================================================
# Auth (single-user session cookie)
# ============================================================================
# There is one user and no user table: AUTH__PASSWORD_HASH (above) is the
# whole credential store. Logging in swaps it for a signed cookie.
# AUTH__SESSION__COOKIE_NAME=arc_session
# AUTH__SESSION__MAX_AGE_SECONDS=1209600
# Send the cookie over HTTPS only. Turn this on once Caddy serves TLS
# (CADDY_SITE_ADDRESS set to a hostname) — with plain HTTP it locks you out.
# AUTH__SESSION__HTTPS_ONLY=false

# ============================================================================
# MCP server (the `mcp` service — `python -m app.mcp.main` on :8001)
# ============================================================================
# Comma-separated `label:scope[+scope]:key` entries; scopes are `read` and
# `write`, and a key may carry both joined by `+` (`write` does not imply
# `read`, so a coaching agent that must read before writing needs
# `read+write`). The label identifies the client in logs and on the request
# identity, and the key is the bearer token the client sends. Keys may not
# contain a colon; generate them with `openssl rand -hex 32`.
#
# The server validates the key material and exits 1 rather than serve a weak
# surface: each key must be at least 32 characters (that recipe gives 64), must
# not still contain `change-me`, and must differ from every other key — labels
# must be unique too.
#
# Single-quote the value: it contains commas and colons, and .env parsers (and
# your shell) otherwise mangle it. Set it in the REQUIRED block above — the
# MCP server refuses to start with no keys.
# MCP__API_KEYS='coach:read+write:<random-hex>,readonly:read:<random-hex>'
#
# Circuit breaker on the agent surface: the most writes any agent key may make
# in a trailing hour, counted over the audit log. Enforced in the service
# layer, so it binds every path an agent can write through. Athlete writes are
# never counted or capped, and a dry run costs nothing because it writes
# nothing.
# MCP__WRITE_CAP_PER_HOUR=60

# ============================================================================
# Dropbox (the connector that delivers rides without an upload)
# ============================================================================
# Setup, once, by hand:
#   1. Go to https://www.dropbox.com/developers/apps and "Create app".
#   2. Choose **Scoped access** and **Full Dropbox** — NOT "App folder". The
#      FIT files are written by Wahoo's and HealthFit's own apps, into *their*
#      app folders, which an app-folder app is structurally unable to read.
#   3. On the Permissions tab tick `account_info.read`, `files.metadata.read`
#      and `files.content.read` (and `files.content.write` if you will later
#      let arc delete files it has ingested), then Submit.
#   4. Copy the **App key** into the line below. There is no app secret to
#      copy: arc connects with PKCE and a code you paste back, so it needs no
#      redirect URI and does not have to be reachable from the internet.
#   5. Restart the api, open Settings in arc, and follow the Dropbox panel.
# DROPBOX__APP_KEY=

# How often each watched folder is asked what has changed, in seconds. Two
# minutes is well inside Dropbox's rate limit, and the phone's own sync to
# Dropbox already costs minutes — shortening this shaves a fraction off a lag
# arc does not control.
# DROPBOX__POLL_INTERVAL_SECONDS=120

# How many consecutive failures on one listing page arc tolerates before it
# moves past that page and records which file it gave up on. Holding the
# position forever would re-download one poisoned batch every poll, for ever.
# DROPBOX__MAX_BATCH_ATTEMPTS=5

# ============================================================================
# Logging
# ============================================================================
# LOG__LEVEL=INFO

# ============================================================================
# Reverse proxy (Caddy) — not a backend setting, read by docker-compose.yml
# ============================================================================
# Site address Caddy serves. The default `:80` is plain HTTP with no
# automatic TLS. Set a hostname (e.g. arc.example.com) and Caddy obtains and
# renews a certificate itself, serving HTTPS on 443.
# CADDY_SITE_ADDRESS=:80

# ============================================================================
# Frontend (baked into the bundle at build time — rebuild after changing)
# ============================================================================
# Empty (the compose default) means "same origin" — the browser talks to
# Caddy, which proxies /api/* to the API. Set an absolute URL only when the
# frontend is served without the proxy (e.g. bare-metal `bun dev`).
# NEXT_PUBLIC_API_BASE_URL=
