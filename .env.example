# ============================================================================
# arc — Environment Configuration
# ============================================================================
# `just init` copies this file to .env and fills in the REQUIRED block below
# with fresh secrets and a hash of the password you choose — prefer it over
# copying by hand.
# Nested keys use Pydantic double-underscore delimiters:
# POSTGRES__HOST maps to settings.postgres.host in backend/app/core/config.py.
# A backend test (test_env_example_completeness) keeps this file in sync with
# the settings model — add new settings here when you add them in code.

# ============================================================================
# REQUIRED — no safe defaults, set before running
# ============================================================================
POSTGRES__PASSWORD=change-me
# bcrypt hash of the single user's password — generate it with
# `just hash-password`. MUST be single-quoted: bcrypt hashes contain `$`,
# which .env parsers and your shell would otherwise expand.
AUTH__PASSWORD_HASH='change-me-to-a-bcrypt-hash'
# Signs the session cookie. Rotating it logs the user out.
# Generate with: openssl rand -hex 32
AUTH__SESSION__SECRET_KEY=change-me-to-a-random-64-char-hex-string
# Required by the `mcp` service only — it exits 1 without keys. `docker
# compose up` starts that service, so set this before booting the stack.
MCP__API_KEYS='coach:write:change-me-random-hex,readonly:read:change-me-random-hex'

# ============================================================================
# Application
# ============================================================================
# APPLICATION_NAME=arc
# ENVIRONMENT=development
# ^ Only affects processes you run on the host (`just dev-api`, `just dev-mcp`,
# tests). docker-compose.yml pins ENVIRONMENT=production on the api and mcp
# services with an `environment:` entry, which overrides this file — so the
# containers always run the production config guard, which refuses to boot with
# an empty AUTH__PASSWORD_HASH or AUTH__SESSION__SECRET_KEY, or with the
# default POSTGRES__PASSWORD. Setting it here will not loosen that.
# API_PATH=/api/v1
# CORS_ORIGINS=["http://localhost:3000"]

# ============================================================================
# PostgreSQL
# ============================================================================
# `db` is the compose service name and only resolves inside the Docker network.
# Host-run processes need localhost instead — `just dev-api`, `just dev-mcp`,
# `just db-upgrade` and `just db-revision` pass POSTGRES__HOST=localhost, which
# overrides this line (a real env var always beats .env).
POSTGRES__HOST=db
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__DB=app

# ============================================================================
# Data (runtime file tree: inbox/, originals/, streams/, quarantine/)
# ============================================================================
# Relative paths resolve against the process working directory. Inside the
# containers this is /app/data, bind-mounted from ./data on the host.
DATA__ROOT=data

# ============================================================================
# Auth (single-user session cookie)
# ============================================================================
# There is one user and no user table: AUTH__PASSWORD_HASH (above) is the
# whole credential store. Logging in swaps it for a signed cookie.
# AUTH__SESSION__COOKIE_NAME=arc_session
# AUTH__SESSION__MAX_AGE_SECONDS=1209600
# Send the cookie over HTTPS only. Turn this on once Caddy serves TLS
# (CADDY_SITE_ADDRESS set to a hostname) — with plain HTTP it locks you out.
# AUTH__SESSION__HTTPS_ONLY=false

# ============================================================================
# MCP server (the `mcp` service — `python -m app.mcp.main` on :8001)
# ============================================================================
# Comma-separated `label:scope:key` entries; scope is `read` or `write`. The
# label identifies the client in logs and on the request identity, and the key
# is the bearer token the client sends. Keys may not contain a colon; generate
# them with `openssl rand -hex 32`.
#
# The server validates the key material and exits 1 rather than serve a weak
# surface: each key must be at least 32 characters (that recipe gives 64), must
# not still contain `change-me`, and must differ from every other key — labels
# must be unique too.
#
# Single-quote the value: it contains commas and colons, and .env parsers (and
# your shell) otherwise mangle it. Set it in the REQUIRED block above — the
# MCP server refuses to start with no keys.
# MCP__API_KEYS='coach:write:<random-hex>,readonly:read:<random-hex>'

# ============================================================================
# Logging
# ============================================================================
# LOG__LEVEL=INFO
# LOG__FILE_PATH=logs/app.log

# ============================================================================
# Reverse proxy (Caddy) — not a backend setting, read by docker-compose.yml
# ============================================================================
# Site address Caddy serves. The default `:80` is plain HTTP with no
# automatic TLS. Set a hostname (e.g. arc.example.com) and Caddy obtains and
# renews a certificate itself, serving HTTPS on 443.
# CADDY_SITE_ADDRESS=:80

# ============================================================================
# Frontend (baked into the bundle at build time — rebuild after changing)
# ============================================================================
# Empty (the compose default) means "same origin" — the browser talks to
# Caddy, which proxies /api/* to the API. Set an absolute URL only when the
# frontend is served without the proxy (e.g. bare-metal `bun dev`).
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_API_PATH=/api/v1
